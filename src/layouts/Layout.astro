---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Portfolio", description = "AI engineer portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@300;400;500;600&family=Roboto:wght@100;300;400;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="font-body">
    <slot />
    <script>
      // Ensure browser restores scroll position on back/forward
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'auto';
      }

      const animatedSelector =
        '[data-animate], [data-exp-animate], [data-sr-animate], [data-sr-pill], [data-sr-lang], [data-about-animate], [data-hiw-animate]';

      // Detect back/forward navigation — skip animations and jump straight to final state
      const navEntry = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;
      const isBackForward = navEntry?.type === 'back_forward';

      if (isBackForward) {
        // Disable transitions so elements snap to final state with no animation
        const style = document.createElement('style');
        style.textContent = `${animatedSelector.split(', ').map((s) => `${s}.in-view`).join(', ')} { transition: none !important; }`;
        document.head.appendChild(style);
        document.querySelectorAll(animatedSelector).forEach((el) => {
          el.classList.add('in-view');
        });
        // Re-enable transitions on the next frame so future scroll behavior is normal
        requestAnimationFrame(() => {
          requestAnimationFrame(() => style.remove());
        });
      } else {
        // First visit / forward nav — use IntersectionObserver for scroll-triggered reveal
        const globalObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
              }
            });
          },
          { threshold: 0.1 }
        );

        document.querySelectorAll(animatedSelector).forEach((el) => {
          globalObserver.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/resume-particles.css";
</style>
