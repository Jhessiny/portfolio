---
const email = "jhessinymattos@gmail.com";
const linkedin = "https://www.linkedin.com/in/jhessiny-mattos/";
const github = "https://github.com/Jhessiny";
---

<section id="contact" class="contact-section">
  <div class="contact-grid-bg"></div>
  <div class="contact-glow"></div>
  <div class="contact-scan"></div>

  <div class="contact-container">
    <div class="contact-label" data-contact-animate>
      <span>CONTACT.OPEN</span>
    </div>

    <h2 class="contact-headline" data-contact-animate>
      LET'S BUILD<br />
      <span class="contact-headline__accent">SOMETHING WORTH SHIPPING<span class="contact-headline__period">.</span></span>
    </h2>

    <div class="contact-prompt" data-contact-animate>
      <span class="contact-prompt__path">~/josm</span><span>&nbsp;$&nbsp;</span><span class="contact-prompt__cmd">./reach-out --to=you</span><span class="contact-prompt__cursor"></span>
    </div>

    <a
      class="contact-primary"
      href={`mailto:${email}?subject=Hello%20Jh%C3%A9ssiny`}
      data-contact-animate
      data-contact-primary
    >
      <span class="contact-primary__bar"></span>
      <span class="contact-primary__scan"></span>
      <span class="contact-primary__bracket contact-primary__bracket--tl"></span>
      <span class="contact-primary__bracket contact-primary__bracket--tr"></span>
      <span class="contact-primary__bracket contact-primary__bracket--bl"></span>
      <span class="contact-primary__bracket contact-primary__bracket--br"></span>

      <span class="contact-primary__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="1.5"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>
      </span>

      <span class="contact-primary__body">
        <span class="contact-primary__label">Primary channel · Email</span>
        <span class="contact-primary__value">{email}</span>
      </span>

      <button
        type="button"
        class="contact-primary__copy"
        data-contact-copy
        data-email={email}
        aria-label="Copy email"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="11" height="11" rx="1.5"/>
          <path d="M5 15V5a1 1 0 0 1 1-1h10"/>
        </svg>
        <span data-contact-copy-label>Copy</span>
      </button>

      <span class="contact-primary__send">
        Send <span class="contact-primary__send-arrow">→</span>
      </span>
    </a>

    <div class="contact-secondary" data-contact-animate>
      <a
        class="contact-card contact-card--linkedin"
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-card__bar"></span>
        <span class="contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/>
          </svg>
        </span>
        <span class="contact-card__body">
          <span class="contact-card__label">Network</span>
          <span class="contact-card__value">linkedin.com/in/jhessiny-mattos</span>
        </span>
        <span class="contact-card__arrow">↗</span>
      </a>

      <a
        class="contact-card contact-card--github"
        href={github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-card__bar"></span>
        <span class="contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.1.82-.26.82-.58 0-.28-.01-1.04-.02-2.04-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.72.09-.72 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.31.76-1.6-2.66-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.53.12-3.19 0 0 1-.32 3.3 1.23.96-.27 1.98-.4 3-.4s2.04.13 3 .4c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.89.12 3.19.77.84 1.23 1.91 1.23 3.22 0 4.6-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.02 2.9-.02 3.29 0 .32.22.69.83.57A12 12 0 0 0 12 .3"/>
          </svg>
        </span>
        <span class="contact-card__body">
          <span class="contact-card__label">Code</span>
          <span class="contact-card__value">github.com/Jhessiny</span>
        </span>
        <span class="contact-card__arrow">↗</span>
      </a>
    </div>

    <div class="contact-status" data-contact-animate>
      <div class="contact-status__pills">
        <span class="contact-status__pill">
          <span class="contact-status__dot"></span>
          AVAILABLE
        </span>
        <span class="contact-status__sep">·</span>
        <span class="contact-status__pill">CONTRACTS</span>
        <span class="contact-status__sep">·</span>
        <span class="contact-status__pill">UTC-3</span>
        <span class="contact-status__sep">·</span>
        <span class="contact-status__pill">ASYNC-FIRST</span>
      </div>
      <div class="contact-status__sig">
        REPLY WINDOW · <b>~24H</b>
      </div>
    </div>
  </div>
</section>

<style>
  @import "./styles.css";
</style>

<script>
  // Reveal-on-scroll
  const elements = document.querySelectorAll('[data-contact-animate]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
  );
  elements.forEach((el) => observer.observe(el));

  // Copy email — preventDefault on the copy button so the mailto anchor doesn't fire
  document.querySelectorAll<HTMLButtonElement>('[data-contact-copy]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const email = btn.getAttribute('data-email') ?? '';
      const label = btn.querySelector<HTMLSpanElement>('[data-contact-copy-label]');
      try {
        await navigator.clipboard.writeText(email);
        btn.dataset.state = 'copied';
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          delete btn.dataset.state;
          if (label) label.textContent = 'Copy';
        }, 1800);
      } catch {
        if (label) label.textContent = 'Press Ctrl+C';
      }
    });
  });
</script>
