---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-row footer-row--top">
      <a href="#home" class="footer-mark">
        <span class="footer-mark__sigil">◇</span>
        <span class="footer-mark__name">JOSM</span>
        <span class="footer-mark__role">AI Engineer</span>
      </a>

      <nav class="footer-nav" aria-label="Footer">
        <a href="#how-i-work">How I Work</a>
        <a href="#case-studies">Case Studies</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
        <a href="/blog">Blog</a>
      </nav>
    </div>

    <div class="footer-row footer-row--bottom">
      <p class="footer-meta">
        &copy; {year} JOSM
        <span class="footer-meta__sep">·</span>
        São José dos Campos · UTC-3
        <span class="footer-meta__sep">·</span>
        v1
      </p>
      <p class="footer-built">
        BUILT WITH <span class="footer-built__accent">INTENT</span>
        <span class="footer-meta__sep">·</span>
        SHIPPED WITH <span class="footer-built__accent">JUDGMENT</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #050a13;
    border-top: 1px solid rgba(100, 255, 218, 0.1);
    font-family: 'IBM Plex Mono', monospace;
    box-sizing: border-box;
    padding: 28px 60px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  /* ── Mark ── */
  .footer-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .footer-mark__sigil {
    color: #64ffda;
    font-size: 12px;
    transform: translateY(1px);
  }
  .footer-mark__name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 20px;
    letter-spacing: 0.14em;
    color: #c8d8e8;
    transition: color 0.3s;
  }
  .footer-mark:hover .footer-mark__name { color: #64ffda; }
  .footer-mark__role {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #5a7a8a;
  }

  /* ── Nav ── */
  .footer-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .footer-nav a {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #6a8a9a;
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-nav a:hover { color: #64ffda; }

  /* ── Bottom row ── */
  .footer-row--bottom {
    padding-top: 16px;
    border-top: 1px dashed rgba(100, 255, 218, 0.07);
  }
  .footer-meta,
  .footer-built {
    margin: 0;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #5a7a8a;
  }
  .footer-meta__sep { color: #2c4554; margin: 0 8px; }
  .footer-built__accent { color: #c8d8e8; }

  @media (max-width: 720px) {
    .footer { padding: 24px 22px; }
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .footer-mark { flex-wrap: wrap; }
    .footer-built { order: -1; }
  }
</style>
