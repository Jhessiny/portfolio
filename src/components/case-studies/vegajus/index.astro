---
import { features, stack, highlights, live } from "../../../data/case-studies/vegajus";

const accent = "#c792ea";
const accentRgb = "199,146,234";
---

  <div class="cs-page" style={`--accent: ${accent}; --accent-rgb: ${accentRgb};`}>
    <!-- Background layers -->
    <div class="cs-noise"></div>
    <div class="cs-grid"></div>

    <!-- ─── Navigation ─── -->
    <nav class="cs-nav" data-animate>
      <a href="/#case-studies" class="cs-nav__back">
        <span class="cs-nav__arrow">&larr;</span>
        <span class="cs-nav__label">Back to projects</span>
      </a>
      <span class="cs-nav__index">02</span>
    </nav>

    <!-- ─── Hero ─── -->
    <header class="cs-hero">
      <div class="cs-hero__meta" data-animate>
        <div class="cs-hero__tag">
          <span class="cs-hero__dot"></span>
          Pre-launch · Early access live
        </div>
        <span class="cs-hero__date">Brazil · PT-BR</span>
      </div>

      <h1 class="cs-hero__title" data-animate>
        <span class="cs-hero__title-main">VEGAJUS</span>
        <span class="cs-hero__title-sub">Legal-Tech SaaS<br/>for Solo Lawyers</span>
      </h1>

      <p class="cs-hero__summary" data-animate>
        Co-founded CRM + <strong>WhatsApp automation</strong> + Meta Ads platform for
        Brazilian solo lawyers. Captures leads, runs the client conversation inside
        WhatsApp, and converts a chat into an open case with one click. Replaces a
        stack of disconnected tools with a single workflow.
      </p>

      <div class="cs-hero__tags" data-animate>
        <span class="cs-hero__pill">Co-founded</span>
        <span class="cs-hero__pill">Legal-Tech</span>
        <span class="cs-hero__pill">Frontend + Product</span>
        <span class="cs-hero__pill">React 19</span>
      </div>

      <a
        class="cs-hero__live"
        href={live.url}
        target="_blank"
        rel="noreferrer noopener"
        data-animate
      >
        {live.label} <span class="cs-hero__live-arrow">↗</span>
      </a>
    </header>

    <!-- ─── Why this, why us ─── -->
    <section class="cs-section" data-animate>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>Why this, why us</span>
      </div>
      <p class="cs-section__intro">
        I trained as a lawyer before moving into tech. My co-founder leads the
        backend. The product exists because the gap between what legal SaaS sells
        and what a solo lawyer actually needs day-to-day is enormous — most tools
        in the Brazilian market either over-target large firms or under-build for
        the small ones. We're building for the user neither side serves.
      </p>
    </section>

    <!-- ─── My Scope ─── -->
    <section class="cs-section" data-animate>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>My Scope</span>
      </div>
      <p class="cs-section__intro">
        End-to-end product and frontend ownership: PRD, persona work, scope cuts,
        UX flows, frontend architecture, and the production React/TS codebase. My
        co-founder owns backend (Spring Boot, hexagonal, modular monolith). I sit
        between the user's reality and the architecture decisions that make the
        product real.
      </p>
    </section>

    <!-- ─── Selected Work ─── -->
    <section class="cs-section" data-animate>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>Selected Work</span>
      </div>
      <h2 class="cs-section__heading">Building<br/><span class="cs-accent">a real product</span></h2>

      <div class="cs-features">
        {features.map((f, i) => (
          <div
            class="cs-feature"
            style={`--feat-color: ${f.accent}; --feat-delay: ${i * 0.1}s;`}
            data-animate
          >
            <div class="cs-feature__header">
              <span class="cs-feature__stage">FEATURE {f.stage}</span>
              <div class="cs-feature__bar"></div>
            </div>
            <h3 class="cs-feature__title">{f.title}</h3>
            <div class="cs-feature__row">
              <span class="cs-feature__key">Problem</span>
              <p class="cs-feature__text">{f.problem}</p>
            </div>
            <div class="cs-feature__row">
              <span class="cs-feature__key">Approach</span>
              <p class="cs-feature__text">{f.approach}</p>
            </div>
            <div class="cs-feature__row">
              <span class="cs-feature__key">Outcome</span>
              <p class="cs-feature__text cs-feature__text--outcome">{f.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Tech Stack ─── -->
    <section class="cs-section" data-animate>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>Tech Stack</span>
      </div>
      <div class="cs-stack">
        {stack.map((s) => (
          <span class="cs-stack__pill">{s.name}</span>
        ))}
      </div>
    </section>

    <!-- ─── Highlights ─── -->
    <section class="cs-section" data-animate>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>What I'd Highlight</span>
      </div>
      <h2 class="cs-section__heading">Founder<br/><span class="cs-accent">depth, not surface</span></h2>

      <div class="cs-highlights">
        {highlights.map((h, i) => (
          <div class="cs-highlight" style={`--hl-delay: ${i * 0.08}s;`} data-animate>
            <span class="cs-highlight__index">0{i + 1}</span>
            <h3 class="cs-highlight__title">{h.title}</h3>
            <p class="cs-highlight__text">{h.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── CTA / Outcome ─── -->
    <section class="cs-section cs-outcome" data-animate>
      <div class="cs-outcome__glow"></div>
      <div class="cs-section__label">
        <div class="cs-section__line"></div>
        <span>Status</span>
      </div>
      <h2 class="cs-outcome__heading">
        Pre-launch.<br/><span class="cs-accent">Early access open.</span>
      </h2>
      <div class="cs-outcome__points">
        <div class="cs-outcome__point">
          <span class="cs-outcome__check">&#x2713;</span>
          <span>Validation prototype shipped &amp; tested with real users</span>
        </div>
        <div class="cs-outcome__point">
          <span class="cs-outcome__check">&#x2713;</span>
          <span>Production v1 in active build — frontend + backend in parallel</span>
        </div>
        <div class="cs-outcome__point">
          <span class="cs-outcome__check">&#x2713;</span>
          <span>WhatsApp integration is the v1 unlock — currently in progress</span>
        </div>
        <div class="cs-outcome__point">
          <span class="cs-outcome__check">&#x2713;</span>
          <span>Early-access landing live, sign-ups open</span>
        </div>
      </div>

      <div class="cs-cta-row">
        <a href="#" class="cs-cta cs-cta--primary">
          Early Access <span>&rarr;</span>
        </a>
        <a href="#" class="cs-cta cs-cta--ghost">
          Demo Video
        </a>
      </div>
    </section>

    <!-- ─── Footer nav ─── -->
    <nav class="cs-footer-nav" data-animate>
      <a href="/#case-studies" class="cs-footer-nav__link">
        <span class="cs-footer-nav__arrow">&larr;</span>
        Back to all projects
      </a>
    </nav>
  </div>

<style define:vars={{ accent, accentRgb }}>
  @import "./styles.css";
</style>

<script>
  const elements = document.querySelectorAll('[data-animate]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
  );
  elements.forEach((el) => observer.observe(el));
</script>
